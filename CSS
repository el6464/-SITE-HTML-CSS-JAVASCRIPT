/* Contact form and current project phase */
.form-honey{position:absolute;left:-9999px;height:1px;overflow:hidden}
.form-status{margin:12px 0 0;color:var(--blue);font-weight:700}
.current{border-color:var(--cyan);box-shadow:0 6px 18px #0875b326}
.menu{flex:0 0 44px;width:44px;height:44px;padding:8px}
.menu span{display:block;width:27px;height:3px;margin:4px auto;border-radius:2px;background:#fff}
@media(max-width:800px){.menu{display:block;order:-1;margin-left:0}.brand{min-width:0}.brand-copy{min-width:0;overflow:hidden}}
:root{--navy:#062c55;--blue:#0875b3;--cyan:#22b9d1;--gold:#f0c35b;--ink:#173b55;--paper:#f5f9fb;--line:#d9e7eb;--muted:#607887;--shadow:0 16px 40px #052e4e26}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Arial,Helvetica,sans-serif;line-height:1.55}a{color:inherit;text-decoration:none}button,input,textarea{font:inherit}.container{width:min(1120px,calc(100% - 36px));margin:auto}
header{position:sticky;top:0;z-index:10;background:#062c55f7;color:#fff;box-shadow:0 3px 18px #05233d40}.nav{min-height:74px;display:flex;align-items:center;gap:20px}.brand{display:flex;align-items:center;gap:12px;margin-right:auto;font-weight:800;line-height:1.05}.brand img{width:54px;height:54px;border:2px solid #d8f5fb;border-radius:50%;object-fit:cover}.brand-copy{display:flex;align-items:center;gap:10px}.brand-title{font-size:1rem;white-space:nowrap}.brand-divider{width:1px;height:28px;background:#8ccbd5}.brand small{display:block;margin-top:3px;color:#bde6ee;font-weight:400;font-size:.68rem;letter-spacing:.02em}.nav-links{display:flex;align-items:center;gap:19px;margin-left:auto;font-size:.86rem}.nav-links a:hover{color:var(--gold)}.menu{display:none;border:0;background:transparent;color:#fff;font-size:1.6rem;cursor:pointer;margin-left:auto}.btn{display:inline-block;border:0;border-radius:8px;padding:12px 19px;cursor:pointer;font-weight:800;transition:.2s}.btn:hover{transform:translateY(-2px);box-shadow:0 7px 18px #04263a2e}.primary{background:var(--gold);color:var(--navy)}.blue{background:var(--blue);color:#fff}.white{background:#fff;color:var(--navy)}
.hero{color:#fff;background:linear-gradient(120deg,#06345f,#087ab7 65%,#36b8cf);padding:78px 0;position:relative;overflow:hidden}.hero:after{content:"";position:absolute;inset:0;opacity:.12;background:repeating-linear-gradient(125deg,transparent 0 90px,#fff 92px 94px,transparent 96px 180px)}.hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:1.2fr .8fr;align-items:center;gap:44px}.eyebrow,.kicker{font-size:.73rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--gold)}h1{font-family:Georgia,serif;font-size:clamp(2.6rem,5vw,4.8rem);line-height:1;margin:14px 0 20px}.hero p{max-width:680px;color:#e4f6f8;font-size:1.08rem}.hero-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.hero-house{justify-self:end;width:100%;overflow:hidden;border:5px solid #fff;border-radius:12px;box-shadow:var(--shadow);transform:rotate(2deg)}.hero-house img{display:block;width:100%;aspect-ratio:1.15;object-fit:cover;object-position:top}
section{padding:70px 0}.alt{background:#eaf5f7}.section-title{margin-bottom:28px}.section-title h2,.modal-box h2{margin:7px 0 8px;color:var(--navy);font-family:Georgia,serif;font-size:clamp(2rem,4vw,3rem);line-height:1}.lead{max-width:760px;color:var(--muted)}.project-panel{display:grid;grid-template-columns:1.05fr .95fr;gap:28px;align-items:center;padding:18px;background:linear-gradient(135deg,#075994,#0874b3);border-radius:12px;color:#fff;box-shadow:var(--shadow)}.project-image{position:relative;overflow:hidden;border-radius:10px}.project-image img{display:block;width:100%;aspect-ratio:1.45;object-fit:cover;object-position:top}.play{position:absolute;left:50%;top:50%;width:70px;height:70px;transform:translate(-50%,-50%);border:4px solid #fff;border-radius:50%;background:var(--blue);color:#fff;font-size:1.5rem;cursor:pointer}.project-panel h2{color:#fff;font-family:Georgia,serif}.project-panel p{color:#ddf4f7}.checks{padding:0;list-style:none}.checks li{display:flex;gap:10px;align-items:center;margin:12px 0}.checks b{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;background:#d8f3f7;color:var(--blue)}
.timeline{display:grid;gap:13px}.step{display:flex;gap:15px;align-items:flex-start;padding:18px;background:#fff;border:1px solid var(--line);border-radius:10px}.dot{display:grid;place-items:center;min-width:31px;width:31px;height:31px;border-radius:50%;background:var(--blue);color:#fff;font-weight:800}.pending .dot{background:#d6e1e4;color:#62737a}.small{color:var(--muted);font-size:.88rem}.funding{display:grid;grid-template-columns:.8fr 1.2fr;gap:38px;align-items:center}.funding-box{padding:25px;background:#fff;border-radius:14px;box-shadow:var(--shadow)}.progress{height:13px;overflow:hidden;background:#e5eef0;border-radius:99px}.progress div{width:50%;height:100%;background:var(--gold)}.funding-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:16px}.funding-stat{padding:13px;background:#eef8f9;border-radius:8px}.funding-stat strong{display:block;color:var(--navy)}.funding-stat span{color:var(--muted);font-size:.78rem}table{width:100%;border-collapse:collapse;background:#fff;border-radius:10px;overflow:hidden}th,td{padding:14px;text-align:left;border-bottom:1px solid var(--line)}th{background:#dff1f4;color:var(--navy)}
.team{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.person{padding:22px;background:#fff;border-top:4px solid var(--cyan);box-shadow:0 6px 20px #15496612}.role{color:var(--blue);font-size:.7rem;font-weight:800;letter-spacing:.16em;font-family:Arial,Helvetica,sans-serif}.person-body{display:flex;align-items:center;gap:14px;margin-top:12px}.person-photo{width:58px;height:58px;flex:0 0 58px;border:3px solid #d6eef2;border-radius:50%;object-fit:cover}.person-info{min-width:0}.person h3{margin:0 0 7px;color:var(--navy);font-family:Georgia,'Times New Roman',serif;font-size:1.35rem;line-height:1.15}.person p{margin:0;color:var(--muted);font-family:Georgia,'Times New Roman',serif;font-size:1.04rem;line-height:1.55}.person p strong{color:var(--ink);font-weight:700}.member-list{display:grid;gap:8px}.member-line{display:flex;align-items:center;gap:8px;color:var(--ink);font-family:Georgia,'Times New Roman',serif;font-size:.95rem}.member-line img{width:25px;height:25px;border:2px solid #d6eef2;border-radius:50%;object-fit:cover}.contribute{background:var(--navy);color:#fff}.contribute h2{color:#fff}.contribute .lead{color:#d5e9ed}.amounts{display:flex;gap:10px;flex-wrap:wrap;margin:24px 0}.amount{border:1px solid #ffffff66;border-radius:8px;padding:11px 18px;background:#fff;color:var(--navy);font-weight:800;cursor:pointer}.amount.active{outline:3px solid var(--gold)}.payment-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{padding:24px;background:#fff;border:1px solid var(--line);border-radius:12px}.card h3{margin:0 0 8px;color:var(--navy)}.card p{color:var(--muted)}.notice{margin-top:18px;padding:14px;border-left:4px solid var(--gold);border-radius:5px;background:#fff8df;color:#57491f}.hidden{display:none}form{max-width:650px;padding:25px;margin-top:20px;background:#fff;color:var(--ink);border-radius:14px}.field{margin-bottom:14px}.field label{display:block;margin-bottom:5px;font-weight:700}.field input,.field textarea{width:100%;padding:12px;border:1px solid #bfd4dc;border-radius:7px}.field textarea{min-height:110px;resize:vertical}
.contact{display:grid;grid-template-columns:.75fr 1.25fr;gap:45px}.contribution-history{margin-top:20px;padding:20px;background:#eaf5f7;border-radius:10px;color:var(--ink)}.contribution-history h3{margin-top:0}.contribution-history ul{padding-left:20px;margin-bottom:0}.toast{position:fixed;right:20px;bottom:20px;z-index:30;max-width:360px;padding:15px 18px;border-radius:8px;background:#08385e;color:#fff;box-shadow:var(--shadow);transform:translateY(150%);transition:.3s}.toast.show{transform:translateY(0)}.modal{display:none;place-items:center;position:fixed;inset:0;z-index:20;padding:18px;background:#021d35cc}.modal.open{display:grid}.modal-box{position:relative;width:min(780px,100%);padding:28px;border-radius:12px;background:#fff}.close{position:absolute;top:8px;right:13px;border:0;background:none;font-size:1.7rem;cursor:pointer}.presentation{overflow:hidden;border-radius:8px;background:#062c55}.presentation video{display:block;width:100%;max-height:430px;background:#062c55}.presentation-caption{padding:13px 15px;color:#fff}.video-note{margin:12px 0 0;color:var(--muted);font-size:.88rem}footer{padding:35px 0;background:#041f3d;color:#c3e0e7;font-size:.88rem}.footer-flex{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
@media(max-width:800px){.container{width:min(100% - 28px,600px)}.menu{display:block}.nav-links{display:none;position:absolute;top:74px;left:0;right:0;padding:18px 24px 24px;flex-direction:column;align-items:flex-start;background:var(--navy)}.nav-links.open{display:flex}.hero-grid,.project-panel,.funding,.contact{grid-template-columns:1fr}.hero-house{justify-self:center;width:min(100%,320px);transform:none}.team,.payment-grid{grid-template-columns:1fr 1fr}.hero{padding:60px 0}section{padding:56px 0}}@media(max-width:500px){.brand-copy{gap:6px}.brand-title{font-size:.82rem}.brand small{font-size:.59rem}.brand-divider{height:24px}.team,.payment-grid,.funding-stats{grid-template-columns:1fr}.hero-actions .btn{width:100%;text-align:center}}
